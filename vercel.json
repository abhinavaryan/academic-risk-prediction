{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd web && npm ci --no-audit --no-fund",
  "buildCommand": "cd web && npm run build",
  "outputDirectory": "web/out",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{web/**,tests/**,docs/**,notebooks/**,reports/**,data/**,build/**,.venv/**,.github/**,.devcontainer/**}"
    }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index" }],
  "redirects": [
    { "source": "/(dataset|models|predict|train|methodology)", "destination": "/$1/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ]
}
