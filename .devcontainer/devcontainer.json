{
  "name": "Agrim (Python + Node)",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "postCreateCommand": "pip install -r requirements-dev.txt && cd web && npm ci && npm run build",
  "postAttachCommand": {
    "server": "SERVE_STATIC=1 python -m uvicorn riskml.server.main:app --host 0.0.0.0 --port 8000"
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Agrim (website + API)", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python", "charliermarsh.ruff", "dbaeumer.vscode-eslint", "bradlc.vscode-tailwindcss"] }
  }
}
